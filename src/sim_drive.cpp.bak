#include <Arduino.h>


// Pin definitions
const int BUILTIN_LED = 13;

void setup() {
  // Serial Start
  Serial.begin(115200);

  Serial.println("Arduino init!");

  delay(500);

  pinMode(BUILTIN_LED, OUTPUT);



}

void loop() {
  digitalWrite(BUILTIN_LED, HIGH);
  delay(1000);

  digitalWrite(BUILTIN_LED, LOW);
  delay(1000);

}



